# ╔══════════════════════════════════════════════════════════╗
# ║  Stock App — 환경 변수 설정                              ║
# ║  이 파일을 .env로 복사한 뒤 API 키를 입력하세요          ║
# ║  $ cp .env.example .env                                 ║
# ╚══════════════════════════════════════════════════════════╝

# ── 외부 API 키 (필수) ───────────────────────────
# DART Open API: https://opendart.fss.or.kr 에서 발급
DART_API_KEY=your_dart_api_key_here

# 한국은행 ECOS API: https://ecos.bok.or.kr 에서 발급
ECOS_API_KEY=your_ecos_api_key_here

# ── DB 설정 ──────────────────────────────────────
DB_NAME=stockapp
DB_USERNAME=stockapp
DB_PASSWORD=stockapp

# ── 자체 로그인 / 최초 관리자 계정 ───────────────
# JWT_SECRET은 32바이트 이상의 충분히 긴 랜덤 문자열로 교체
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# HTTPS 운영은 true. 로컬 HTTP에서 쿠키 테스트 시에만 false.
AUTH_COOKIE_SECURE=true
# CORS 허용 origin(쉼표 구분). 운영 도메인을 반드시 포함시킬 것. 예: https://your-domain.com
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

# ── DB 자동 백업 (backup 서비스) ─────────────────
# 저장 폴더. 미지정 시 프로젝트 루트 ./backups. 디스크 고장 대비해 클라우드 동기화 폴더 권장.
#   예) BACKUP_DIR=C:/Users/<사용자>/OneDrive/jipyo-backups
# BACKUP_DIR=./backups
BACKUP_HOUR=4          # 매일 백업 시각(KST, 0~23)
BACKUP_KEEP_DAYS=14    # 백업 보관 일수
