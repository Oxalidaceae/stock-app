# ╔══════════════════════════════════════════════════════════╗
# ║  Stock App — 환경 변수 설정                              ║
# ║  이 파일을 .env로 복사한 뒤 API 키를 입력하세요          ║
# ║  $ cp .env.example .env                                 ║
# ╚══════════════════════════════════════════════════════════╝

# ── 외부 API 키 (필수) ───────────────────────────
# DART Open API: https://opendart.fss.or.kr 에서 발급
DART_API_KEY=your_dart_api_key_here

# 한국은행 ECOS API: https://ecos.bok.or.kr 에서 발급
ECOS_API_KEY=your_ecos_api_key_here

# ── DB 설정 ──────────────────────────────────────
DB_NAME=stockapp
DB_USERNAME=stockapp
DB_PASSWORD=stockapp

# ── 자체 로그인 / 최초 관리자 계정 ───────────────
# JWT_SECRET은 32바이트 이상의 충분히 긴 랜덤 문자열로 교체
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# HTTPS 운영은 true. 로컬 HTTP에서 쿠키 테스트 시에만 false.
AUTH_COOKIE_SECURE=true
# CORS 허용 origin(쉼표 구분). 운영 도메인을 반드시 포함시킬 것. 예: https://your-domain.com
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com

# ── 따봉/비추 스팸 방어 ──────────────────────────
# IP당 분당 반응 허용 횟수 (초과 시 429)
REACTION_RATE_LIMIT_PER_MINUTE=30
# 반응 IP 해시 salt — 임의 문자열로 교체 권장(기본값은 공개돼 있어 해시 추측 여지)
REACTION_IP_SALT=change-this-random-salt

# ── 수집 실패 알림 ───────────────────────────────
# 수집이 연속 실패하면 알림이 온다 — 정책브리핑 RSS 가 폐지됐을 때 로그에만 남아
# 36일간 아무도 몰랐던 일을 다시 겪지 않기 위한 장치.
# 비워두면 알림을 보내지 않는다(로컬 개발 기본). 텔레그램/Discord/Slack 지원.
#
# 텔레그램 설정:
#   1) @BotFather 에게 /newbot → 봇 토큰 발급 (예: 123456789:AAE...)
#   2) 만든 봇과 대화를 시작하고 아무 메시지나 보낸다 (봇이 먼저 말을 걸 수 없음)
#   3) curl https://api.telegram.org/bot<토큰>/getUpdates
#      → result[].message.chat.id 가 CHAT_ID (개인 대화는 양수, 그룹은 음수)
#   4) 아래 두 줄을 채우고 `docker compose run --rm collector-daemon --test-alert` 로 확인
# COLLECTOR_ALERT_WEBHOOK=https://api.telegram.org/bot123456789:AAE.../sendMessage
# COLLECTOR_ALERT_CHAT_ID=123456789
#
# Discord 를 쓸 경우: 채널 설정 → 연동 → 웹후크 URL 만 넣으면 되고 CHAT_ID 는 불필요.
COLLECTOR_ALERT_WEBHOOK=
COLLECTOR_ALERT_CHAT_ID=
# 몇 회 연속 실패해야 알림을 보낼지 (시간당 실행 기준, 기본 3 = 약 3시간)
COLLECTOR_ALERT_THRESHOLD=3

# ── Cloudflare Tunnel (리눅스 운영 서버에서만) ───
# 터널을 컨테이너로 띄울 때만 설정한다. 로컬 개발에서는 둘 다 비워두면 된다.
# COMPOSE_PROFILES=tunnel 이 있어야 cloudflared 서비스가 기동한다.
#   토큰: Cloudflare Zero Trust → Networks → Tunnels → 해당 터널 → Install connector 에서 복사
#   ⚠ 같은 토큰을 두 대에서 동시에 돌리면 트래픽이 양쪽으로 분배된다. 이전 서버는 반드시 먼저 끌 것.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=eyJhIjoi...

# ── DB 자동 백업 (backup 서비스) ─────────────────
# 저장 폴더. 미지정 시 프로젝트 루트 ./backups. 디스크 고장 대비해 클라우드 동기화 폴더 권장.
#   윈도우 예) BACKUP_DIR=C:/Users/<사용자>/OneDrive/jipyo-backups
#   리눅스 예) BACKUP_DIR=/home/<사용자>/jipyo-backups   (rclone 등으로 오프사이트 동기화)
# BACKUP_DIR=./backups
BACKUP_HOUR=4          # 매일 백업 시각(KST, 0~23)
BACKUP_KEEP_DAYS=14    # 백업 보관 일수
